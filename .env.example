# Salin file ini ke .env dan isi nilainya

# Database Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret JWT session — gunakan string acak minimal 32 karakter
# Generate di: https://generate-secret.vercel.app/64
AUTH_SECRET="isi-dengan-string-acak-panjang-minimal-32-karakter"

# Vercel Blob Storage — untuk upload foto di production
# Cara dapat token: Vercel Dashboard > Storage > Create Blob Store > .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
